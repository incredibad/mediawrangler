# MediaWrangler settings. Copy to .env (chmod 600). Everything else is set in the UI.

# --- Host side (used by compose.yaml) ---
# Image tag to run.
MW_VERSION=latest
# Where the database, backups and exports live on the host.
MW_HOST_DATA_DIR=./data
# The media share on the host, mounted read-only at /media in the container.
MW_HOST_MEDIA_DIR=/mnt/media
# The share's library folders (comma separated); leave empty to list every top-level folder.
MW_MEDIA_FOLDERS=TV,Movies,Movies4K,Anime,Sport
# File holding the master encryption key. Create it once with:
#   mkdir -p secrets && openssl rand -base64 48 > secrets/secret.key && chmod 600 secrets/secret.key
# Keep a copy somewhere safe: stored connector keys can't be decrypted without it.
MW_HOST_SECRET_KEY_FILE=./secrets/secret.key

# --- Container side ---
MW_PORT=8790
# Where your apps send webhooks (LAN only; never behind the public proxy). 0 turns it off.
MW_WEBHOOK_PORT=8791
# The URL you open MediaWrangler at. https:// turns on secure cookies and HSTS
# (internet-facing). http:// means LAN-only mode.
MW_PUBLIC_URL=http://localhost:8790
# Comma-separated IPs/CIDRs of your reverse proxy, so real client IPs are used
# for lockout and the sign-in log. Leave empty if there is no proxy.
MW_TRUSTED_PROXIES=
TZ=UTC
PUID=1000
PGID=1000
MW_LOG_LEVEL=info
