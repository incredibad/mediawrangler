# Optional: instead of editing docker-compose.yml, copy this to .env next to it
# (chmod 600) and change what you need. Everything else is set in the UI.

# --- Host side ---
# Image tag to run.
MW_VERSION=latest
# Where the database, backups and the encryption key live on the host.
MW_HOST_DATA_DIR=./data
# The media share on the host, mounted at /media in the container.
MW_HOST_MEDIA_DIR=/mnt/media

# --- Container side ---
# The share's library folders (comma separated); leave empty to list every top-level folder.
MW_MEDIA_FOLDERS=TV,Movies
MW_PORT=8790
# Where your apps send webhooks (LAN only; never behind the public proxy). 0 turns it off.
MW_WEBHOOK_PORT=8791
# The URL you open MediaWrangler at. https:// turns on secure cookies and HSTS
# (internet-facing). http:// means LAN-only mode.
MW_PUBLIC_URL=http://localhost:8790
# Comma-separated IPs/CIDRs of your reverse proxy, so real client IPs are used
# for lockout and the sign-in log. Leave empty if there is no proxy.
MW_TRUSTED_PROXIES=
TZ=UTC
PUID=1000
PGID=1000
MW_LOG_LEVEL=info
